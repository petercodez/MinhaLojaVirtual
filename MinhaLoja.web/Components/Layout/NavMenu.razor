@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject MinhaLoja.web.Services.CarrinhoService CarrinhoService
@implements IDisposable
@inject HttpClient Http

<nav class="navbar navbar-expand-lg navbar-dark px-4 shadow-sm" style="background-color: #0b0b0b;">
    <div class="container-fluid">
        
        <a class="navbar-brand fw-bold fs-3 text-white" href="/">
            STRING<span class="text-warning">HEAVEN</span>
        </a>

        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
            <li class="nav-item"><a class="nav-link text-white text-uppercase" style="font-size: 0.85rem;" href="/">Guitarras</a></li>
        </ul>

        <div class="d-flex align-items-center gap-4 me-4">

            <a href="/carrinho" class="text-decoration-none">
                <div class="position-relative text-white" style="cursor: pointer;">
                    <i class="bi bi-cart3 fs-4"></i>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-circle text-dark" style="background-color: #ffd700; font-size: 0.7rem; padding: 0.35em 0.5em;">
                        @quantidadeCarrinho
                    </span>
                </div>            
            </a>

            <div class="nav-item dropdown user-dropdown position-relative" style="cursor: pointer;">
                <div class="text-white px-1">
                    <i class="bi bi-person-circle fs-4"></i>
                </div>
                
                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-0 custom-dropdown" style="right: 0; left: auto; min-width: 200px;">
                    <AuthorizeView>
                        
                        @* LOGADO *@
                        <Authorized>
                            <li><div class="dropdown-header text-center bg-warning text-dark fw-bold py-2 fs-6">Olá, @primeiroNome</div></li>
                            <li><a class="dropdown-item py-2" href="/minha-conta">Minha conta</a></li>
                            <li><a class="dropdown-item py-2" href="/meus-pedidos">Meus pedidos</a></li>
                            <li><hr class="dropdown-divider m-0"></li>
                            <li><button class="dropdown-item py-2 text-danger fw-bold" @onclick="Sair">Sair</button></li>
                        </Authorized>

                        @* DESLOGADO *@
                        <NotAuthorized>
                            <li>
                                <a class="dropdown-header text-center bg-warning text-dark fw-bold py-2 fs-6 text-decoration-none hover-entrar" href="/login">
                                    Entrar
                                </a>
                            </li>
                            <li><a class="dropdown-item py-2" href="/cadastro">Cadastre-se</a></li>
                            <li><hr class="dropdown-divider m-0"></li>
                            @* Ao clicar no minha conta deslogado, será levado para uma tela de cadastro, mudar depois *@
                            <li><a class="dropdown-item py-2" href="/cadastro">Minha conta</a></li>
                            <li><a class="dropdown-item py-2" href="/cadastro">Meus pedidos</a></li>
                        </NotAuthorized>

                    </AuthorizeView>
                </ul>
            </div>

        </div>
    </div>
</nav>

<style>
    /* Mantém o menu aberto ao passar o mouse */
    .user-dropdown:hover .dropdown-menu {
        display: block;
        margin-top: 0 !important; 
    }
    
    /* Borda amarela no topo do dropdown */
    .custom-dropdown {
        border-top: 4px solid #ffd700 !important; 
    }

    /* Efeito de Hover nos links comuns (Minha Conta, Meus Pedidos, Sair) */
    .dropdown-item {
        cursor: pointer;
        transition: background-color 0.2s ease-in-out;
    }
    
    .dropdown-item:hover {
        background-color: #e9ecef !important; /* Cinza mais escuro para destacar */
        color: #000;
    }

    /* Efeito de Hover específico para o botão amarelo de Entrar */
    .hover-entrar:hover {
        background-color: #e6c200 !important; /* Um amarelo levemente mais escuro */
        color: #000 !important;
    }
</style>

@code {
    private int quantidadeCarrinho = 0;
    private string primeiroNome = "";

    protected override async Task OnInitializedAsync()
    {
        // 1. Inicia o Carrinho
        await AtualizarQuantidade();
        CarrinhoService.OnChange += AtualizarTela;
        
        // 2. Fica "escutando" caso o usuário faça login ou logout para mudar o nome na hora
        AuthStateProvider.AuthenticationStateChanged += AtualizarNomeUsuario;

        // 3. Carrega o nome na primeira vez que a tela abre
        await CarregarNome(await AuthStateProvider.GetAuthenticationStateAsync());
    }

    // ==========================================
    // LÓGICA DO NOME DO USUÁRIO
    // ==========================================
    private async void AtualizarNomeUsuario(Task<AuthenticationState> taskState)
    {
        var state = await taskState;
        await CarregarNome(state);
        StateHasChanged(); // Manda o HTML redesenhar com o nome novo!
    }

    private async Task CarregarNome(AuthenticationState authState)
    {
        if (authState.User.Identity is not null && authState.User.Identity.IsAuthenticated)
        {
            try
            {
                var token = await LocalStorage.GetItemAsync<string>("authToken");
                Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                
                // Vai no PostgreSQL procurar a ficha do cliente
                var response = await Http.GetAsync("api/Cliente/meu-perfil");
                if (response.IsSuccessStatusCode)
                {
                    var perfil = await response.Content.ReadFromJsonAsync<MinhaLoja.Core.DTOs.ClienteDTO>();
                    if (perfil != null && !string.IsNullOrWhiteSpace(perfil.NomeCompleto))
                    {
                        // Quebra o nome nos espaços e pega só a primeira palavra (ex: "Josias Silva" vira "Josias")
                        primeiroNome = perfil.NomeCompleto.Split(' ')[0];
                        return;
                    }
                }
                
                // PLANO B: Se ele acabou de se cadastrar no checkout mas ainda não tem nome no banco,
                // usamos o que vem antes do @ do e-mail dele!
                var email = authState.User.Identity.Name ?? "";
                primeiroNome = email.Split('@')[0];
            }
            catch
            {
                primeiroNome = "Visitante";
            }
        }
        else
        {
            primeiroNome = "";
        }
    }

    // ===========================
    // LÓGICA DO CARRINHO E LOGOUT
    // ===========================
    private async void AtualizarTela()
    {
        await AtualizarQuantidade();
        StateHasChanged(); 
    }

    private async Task AtualizarQuantidade()
    {
        var itens = await CarrinhoService.ObterCarrinho();
        quantidadeCarrinho = itens.Count;
    }

    private async Task Sair()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        var customAuthStateProvider = (MinhaLoja.web.Services.CustomAuthStateProvider)AuthStateProvider;
        customAuthStateProvider.NotifyUserLogout();
        Navigation.NavigateTo("/", forceLoad: true); 
    }

    // Desliga os "alarmes" se a pessoa fechar a aba do navegador
    public void Dispose()
    {
        CarrinhoService.OnChange -= AtualizarTela;
        AuthStateProvider.AuthenticationStateChanged -= AtualizarNomeUsuario;
    }
}