@using MinhaLoja.web.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">MinhaLoja.web</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
    
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
        </NavLink>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="nav-item px-3">
                <span class="nav-link text-success fw-bold">
                    <span class="bi bi-person-badge-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                </span>
            </div>
            <div class="nav-item px-3">
                <button class="nav-link btn btn-link text-danger" style="cursor: pointer; text-align: left;" @onclick="FazerLogout">
                    <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Sair
                </button>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-door-open-fill-nav-menu" aria-hidden="true"></span> Entrar
                </NavLink>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</nav>
</div>

@code {
    private async Task FazerLogout()
    {
        // Chama o serviço que remove o token do LocalStorage
        await AuthService.LogoutAsync();
        
        // Redireciona o usuário para a tela de login forçando o recarregamento da página
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
