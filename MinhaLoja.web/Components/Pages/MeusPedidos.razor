@page "/meus-pedidos"
@using MinhaLoja.Core.DTOs
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="container mt-5">
    <h2 class="fw-bold mb-4">Meus Pedidos</h2>

    @if (carregando)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-warning" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
            <p class="mt-2 text-muted">Buscando seu histórico...</p>
        </div>
    }
    else if (pedidos.Count == 0)
    {
        <div class="alert alert-light text-center shadow-sm p-5 border-0">
            <i class="bi bi-box-seam text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 fw-bold text-muted">Você ainda não possui pedidos</h4>
            <p>Que tal dar uma olhada na nossa vitrine e escolher seu próximo instrumento?</p>
            <a href="/" class="btn btn-warning mt-2 fw-bold">Ir para a Vitrine</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var pedido in pedidos)
            {
                <div class="col-12 mb-4">
                    <div class="card shadow-sm border-0" style="border-left: 4px solid #ffd700;">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                            <div>
                                <span class="text-muted small">Pedido realizado em</span>
                                <br />
                                <span class="fw-bold fs-5">@pedido.DataPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-success mb-1">@pedido.Status</span>
                                <br />
                                <span class="fw-bold">Total: @pedido.ValorTotal.ToString("C")</span>
                            </div>
                        </div>
                        <div class="card-body bg-light">
                            <ul class="list-group list-group-flush border-0">
                                @foreach (var item in pedido.Itens)
                                {
                                    <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0">
                                        <div>
                                            <span class="fw-bold">@item.NomeProduto</span>
                                            <br />
                                            <span class="text-muted small">Quantidade: @item.Quantidade</span>
                                        </div>
                                        <span>@item.PrecoUnitario.ToString("C")</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<PedidoReadDTO> pedidos = new();
    private bool carregando = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        
        // Se estiver anônimo, redirecionar para login
        if (authState.User.Identity is null || !authState.User.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            // Pega o crachá
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            // Busca os pedidos na API
            var response = await Http.GetAsync("api/Pedido/meus-pedidos");
            if (response.IsSuccessStatusCode)
            {
                pedidos = await response.Content.ReadFromJsonAsync<List<PedidoReadDTO>>() ?? new();
            }
        }
        catch
        {
            // Tratamento silencioso em caso de falha de conexão
        }
        finally
        {
            carregando = false;
        }
    }
}