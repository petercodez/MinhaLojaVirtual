@page "/cadastrar-produto"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using MinhaLoja.Core.DTOs
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title text-center mb-4">Cadastrar Novo Produto</h3>

                    @if (!string.IsNullOrEmpty(mensagem))
                    {
                        <div class="alert alert-@tipoAlerta">@mensagem</div>
                    }

                    <EditForm Model="@produtoDto" OnValidSubmit="SalvarProduto" FormName="formCadastroProduto">
                        <div class="mb-3">
                            <label class="form-label">Nome do Produto</label>
                            <InputText @bind-Value="produtoDto.Nome" class="form-control" />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Descrição</label>
                            <InputTextArea @bind-Value="produtoDto.Descricao" class="form-control" rows="3" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Preço (R$)</label>
                                <InputNumber @bind-Value="produtoDto.Preco" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">ID da Categoria</label>
                                <InputNumber @bind-Value="produtoDto.CategoriaId" class="form-control" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            <span class="bi bi-save" aria-hidden="true"></span> Salvar Produto
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ProdutoCreateDTO produtoDto = new();
    private string mensagem = "";
    private string tipoAlerta = "info";

    private async Task SalvarProduto()
    {
        mensagem = "";

        // O JwtDelegatingHandler vai colar o token secretamente nesta requisição
        var response = await Http.PostAsJsonAsync("api/produtos", produtoDto);

        if (response.IsSuccessStatusCode)
        {
            tipoAlerta = "success";
            mensagem = "Produto cadastrado com sucesso!";
            produtoDto = new(); // Limpa o formulário
        }
        else
        {
            tipoAlerta = "danger";
            mensagem = $"Erro ao cadastrar. O servidor retornou: {response.StatusCode}";
        }
    }
}