@page "/"
@using MinhaLoja.Core.DTOs
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject MinhaLoja.web.Services.CarrinhoService CarrinhoService

<PageTitle>Minha Loja Virtual</PageTitle>

<div class="container mt-4">
    <h2 class="mb-5 text-center fw-bold">Nossa Vitrine</h2>

    @* Botão de Cadastrar Produto (Apenas Admin) *@
    <AuthorizeView Roles="Admin">
        <Authorized>
            <div class="d-flex justify-content-end mb-4">
                <a href="/cadastrar-produto" class="btn btn-success fw-bold shadow-sm">
                    <span class="bi bi-plus-circle" aria-hidden="true"></span> Cadastrar Novo Produto
                </a>
            </div>
        </Authorized>
    </AuthorizeView>

    @if (produtos == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
        </div>
    }
    else if (!produtos.Any())
    {
        <div class="alert alert-info text-center shadow-sm">Nenhum produto cadastrado.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var produto in produtos)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 bg-light">
                            <div class="card-body d-flex flex-column">
                                <span class="badge bg-dark text-white mb-2" style="width: fit-content;">@produto.CategoriaNome</span>
                                
                                <h5 class="card-title fw-bold">@produto.Nome</h5>
                                <p class="card-text text-muted flex-grow-1">@produto.Descricao</p>
            
                                <hr class="text-muted" />

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="text-muted small">À vista no PIX</span>
                                    <span class="fs-4 fw-bold text-success">@produto.Preco.ToString("C")</span>
                                </div>
                                <button class="btn btn-outline-primary w-100" @onclick="() => AdicionarProduto(produto)">
                                    Comprar
                                </button>
                            </div>

                            @* PAINEL DO ADMINISTRADOR (SÓ ADMIN VÊ) *@
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <div class="mt-3 d-flex justify-content-between border-top pt-3">
                                        <button class="btn btn-sm btn-warning fw-bold text-dark" @onclick="() => IrParaEdicao(produto.Id)">
                                            <span class="bi bi-pencil-square" aria-hidden="true"></span> Editar
                                        </button>
                                        <button class="btn btn-sm btn-danger fw-bold" @onclick="() => ExcluirProduto(produto.Id, produto.Nome)">
                                            <span class="bi bi-trash" aria-hidden="true"></span> Excluir
                                        </button>
                                    </div>
                                </Authorized>
                            </AuthorizeView>
                            
                        </div>
                    </div>
            }
        </div>
    }
</div>

@code {
    private List<ProdutoReadDTO>? produtos;

    // Quando a página carrega, chama o método que busca os produtos
    protected override async Task OnInitializedAsync()
    {
        await CarregarProdutos();
    }

    private async Task CarregarProdutos()
    {
        try
        {
            produtos = await Http.GetFromJsonAsync<List<ProdutoReadDTO>>("api/produtos");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro: {ex.Message}");
            produtos = new List<ProdutoReadDTO>(); 
        }
    }

    private void IrParaEdicao(int id)
    {
        // Joga o Admin para a tela de edição passando o ID na URL
        Navigation.NavigateTo($"/editar-produto/{id}");
    }

    private async Task ExcluirProduto(int id, string nome)
    {
        // 1. Exibe a janela de confirmação nativa do navegador
        bool confirmado = await JS.InvokeAsync<bool>("confirm", $"Tem certeza que deseja APAGAR o produto '{nome}'?");
        
        if (confirmado)
        {
            // 2. Se disser sim, bate na API com o método DELETE
            var response = await Http.DeleteAsync($"api/produtos/{id}");
            
            if (response.IsSuccessStatusCode)
            {
                // 3. Se deu certo, recarrega a lista para o produto sumir da tela instantaneamente
                await CarregarProdutos();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Erro ao excluir o produto. Verifique o servidor.");
            }
        }
    }
    private async Task AdicionarProduto(ProdutoReadDTO produtoSelecionado)
    {
        // Envia a guitarra selecionada para o "cérebro" do carrinho
        await CarrinhoService.AdicionarAoCarrinho(produtoSelecionado);
    }
}